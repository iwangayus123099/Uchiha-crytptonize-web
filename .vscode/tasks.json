{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependensi",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "Jalankan dev server",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never__$" },
        "background": {
          "activeBegins": "VITE",
          "endsPattern": "Local:"
        }
      }
    }
  ]
}
